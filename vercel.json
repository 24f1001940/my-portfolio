{
  "functions": {
    "server.js": {
      "runtime": "@vercel/node@24.0.0",
      "includeFiles": "{index.html,404.html,*.css,*.js,*.json,*.pdf,images/**,game/**,courses/**,blog/**}"
    },
    "api/**/*.js": {
      "runtime": "@vercel/node@24.0.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
