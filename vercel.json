{
  "functions": {
    "server.js": {
      "runtime": "nodejs24.x",
      "includeFiles": "{index.html,404.html,*.css,*.js,*.json,*.pdf,images/**,game/**,courses/**,blog/**}"
    },
    "api/**/*.js": {
      "runtime": "nodejs24.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
